[Unit]
Description=Hayabusa Plus DFIR Console
After=network.target
Wants=network.target

[Service]
Type=simple
User=dfir
Group=dfir
WorkingDirectory=/opt/hayabusa-plus
EnvironmentFile=/etc/hayabusa-plus/hayabusa.env
ExecStart=/usr/bin/python3 /opt/hayabusa-plus/gui/server.py
Restart=on-failure
RestartSec=5
UMask=0077
LimitNOFILE=65536

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/hayabusa-plus
ReadWritePaths=/opt/hayabusa-plus/bin/logs
ReadWritePaths=/opt/hayabusa-plus/lookups
ReadWritePaths=/opt/hayabusa-plus/suppressions

[Install]
WantedBy=multi-user.target
